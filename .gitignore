# --- Vivado Temporary and Log Files ---
*.log
*.jou
*.str
*.txt
.Xil/
vivado*.str
vivado*.jou
vivado*.log

# --- Project Outputs and Artefacts ---
*.dir/
*.gen/
*.pb
*.rpt
*.vdi
*.bxml
*.ltx
*.wpc

# --- IP Core Generated Files ---
# Ignore everything generated by IP cores except the core configuration itself (.xci)
**/*.srcs/sources_1/ip/*/*
!**/*.srcs/sources_1/ip/*/*.xci

# --- Block Design Generated Files ---
# Ignore everything generated by Block Designs except the wrapper and diagram (.bd)
**/*.srcs/sources_1/bd/*/*
!**/*.srcs/sources_1/bd/*/*.bd
!**/*.srcs/sources_1/bd/*/hdl/

# --- SDK / Vitis Workspace Outputs ---
.metadata/
.XilVivado/
RemoteWorkspace/
WorkSpace/

# --- Vivado Simulation Outputs & Tools ---
*.sim/
xsim.dir/
*.wdb
*.wcfg.bak

# --- Vivado Cache/Runs
*.cache/
*.runs/
*.hw/
*.ip_user_files/

# --- OS Specific Files ---
.DS_Store
Thumbs.db